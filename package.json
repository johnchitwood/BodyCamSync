{
  "name": "bodycamsync",
  "productName": "BodyCamSync",
  "version": "0.1.0",
  "description": "Synchronized multi-camera video review",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "icon": "electron scripts/make-icon.js"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sherpa-onnx-node": "^2.0.2"
  },
  "build": {
    "appId": "com.bodycamsync.app",
    "productName": "BodyCamSync",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/**",
      "!node_modules/ffprobe-static/bin/darwin/x64/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-darwin-arm64/**",
      "src/main/diarWorker.js",
      "node_modules/ffmpeg-static/ffmpeg",
      "node_modules/ffprobe-static/bin/darwin/arm64/ffprobe"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.video"
    }
  }
}
